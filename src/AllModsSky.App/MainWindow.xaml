<Window x:Class="AllModsSky.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AllModsSky.App.Localization"
        xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
        xmlns:views="clr-namespace:AllModsSky.App.Views"
        xmlns:controls="clr-namespace:AllModsSky.App.Controls"
        Title="All Mod's Sky"
        Height="900" Width="1380" MinHeight="740" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModPoolViewModel}">
            <views:ModPoolView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}">
            <views:DiscoverView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== 侧栏 ===================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgElev}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌：放大的全息行星 + 可越出球体的拖尾光点卫星（无底板，直接浮在侧栏上） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,26">
                    <controls:HoloLogo Width="64" Height="64" />
                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="All Mod's Sky" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="A NMS MOD MANAGER" FontSize="9.5" Foreground="{DynamicResource TextFaint}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Library"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Library, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,12,0"
                                  Data="M12 2 2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5" />
                            <TextBlock Text="{loc:T 模组}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Pool"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Pool, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,12,0"
                                  Data="M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z" />
                            <TextBlock Text="{loc:T 模组库}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Discover"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Discover, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,12,0"
                                  Data="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z" />
                            <TextBlock Text="{loc:T 发现模组}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Tools"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Tools, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,12,0"
                                  Data="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                            <TextBlock Text="{loc:T 工具}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,12,0"
                                  Data="M21 4h-7 M10 4H3 M21 12h-9 M8 12H3 M21 20h-5 M12 20H3 M14 2v4 M8 10v4 M16 18v4" />
                            <TextBlock Text="{loc:T 设置}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="About"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=About, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,12,0"
                                  Data="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 16v-4 M12 8v.01" />
                            <TextBlock Text="{loc:T 关于}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 启动游戏 -->
                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding LaunchCommand}"
                            AutomationProperties.Name="{loc:T 启动游戏}"
                            HorizontalAlignment="Stretch" Padding="7,10"
                            ToolTip="{loc:T 同步当前启停状态后启动游戏；想玩原版就先切到「无模组」配置}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T 启动游戏}" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- 主题 -->
                <Grid Grid.Row="4" Margin="2,12,2,0">
                    <TextBlock Text="{loc:T 深色模式}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" IsChecked="{Binding IsDark, Mode=TwoWay}" />
                </Grid>

                <!-- 页脚 -->
                <StackPanel Grid.Row="5" Margin="2,16,2,0">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                    <Grid>
                        <TextBlock Text="{Binding AppVersion}" FontSize="10.5" Foreground="{DynamicResource TextFaint}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:T 日志}" Style="{StaticResource LinkButton}"
                                    FontSize="10.5" Margin="0,0,12,0"
                                    ToolTip="{loc:T latest.log 与历史归档都在这里}"
                                    Command="{Binding OpenLogFolderCommand}" />
                            <Button Content="{loc:T 数据目录}" Style="{StaticResource LinkButton}"
                                    FontSize="10.5"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 内容 ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Content="{Binding CurrentPageViewModel}" Margin="28,22,28,10"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <!-- 状态栏：无边框无阴影，只靠背景色差与内容区分隔 -->
            <Border Grid.Row="1" Background="{DynamicResource BgElev}" BorderThickness="0">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding StatusLeft}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="640" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusRight}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== 轻提示 ===================== -->
        <Grid x:Name="ToastHost"
              Grid.Column="1"
              Panel.ZIndex="90"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,64"
              MaxWidth="600"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ToastScale" ScaleX="0.9" ScaleY="0.9" />
                    <TranslateTransform x:Name="ToastTranslate" Y="18" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 外层：柔和阴影（不写进气泡内部） -->
            <Border Background="{DynamicResource Surface3}" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="42" ShadowDepth="9" Opacity="0.55" Color="#000000" />
                </Border.Effect>
            </Border>

            <!-- 外层：品牌色柔光 -->
            <Border Background="{DynamicResource Accent}" CornerRadius="14" Opacity="0.16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="46" ShadowDepth="0" Opacity="0.65" Color="{DynamicResource AccentColor}" />
                </Border.Effect>
            </Border>

            <Border Background="{DynamicResource Surface3}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18,13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToastIcon}" FontWeight="Bold" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ToastMessage}" FontSize="14" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== 忙碌遮罩 ===================== -->
        <Grid Grid.Column="1" Panel.ZIndex="120" Background="#66000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="26,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.4" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Spinner}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding BusyText}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
