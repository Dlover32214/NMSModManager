<Window x:Class="AllModsSky.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
        xmlns:views="clr-namespace:AllModsSky.App.Views"
        Title="All Mod's Sky"
        Height="900" Width="1380" MinHeight="740" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}">
            <views:DiscoverView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== 侧栏 ===================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgElev}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌：放大的全息行星 + 可越出徽章的拖尾光点卫星 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,26">
                    <Grid Width="64" Height="64">
                        <!-- 徽章背景；轨道 Canvas 比它大，卫星可以飞到背景外 -->
                        <Border Width="46" Height="46" CornerRadius="14"
                                Background="{DynamicResource BrandGradient}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Canvas Width="64" Height="64" ClipToBounds="False">
                            <Canvas.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MoonOrbit"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:20"
                                                             RepeatBehavior="Forever" />
                                            <DoubleAnimation Storyboard.TargetName="HoloRing"
                                                             Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="0" To="-10"
                                                             Duration="0:0:6"
                                                             RepeatBehavior="Forever" />
                                            <DoubleAnimation Storyboard.TargetName="HoloGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.45" To="0.82"
                                                             Duration="0:0:3"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Canvas.Triggers>

                            <!-- 行星外层全息辉光 -->
                            <Ellipse x:Name="HoloGlow" Width="38" Height="38"
                                     Canvas.Left="13" Canvas.Top="13" Opacity="0.55">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#0038BDF8" Offset="0.32" />
                                        <GradientStop Color="#6638BDF8" Offset="0.66" />
                                        <GradientStop Color="#0038BDF8" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <!-- 卫星 + 拖尾：旋转后压扁，形成伪 3D 椭圆轨道 -->
                            <Grid Width="64" Height="64">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="MoonOrbit" CenterX="32" CenterY="32" />
                                        <ScaleTransform ScaleY="0.48" CenterX="32" CenterY="32" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- 拖尾外层柔光 -->
                                <Path Data="M 13.36,9.78 A 29,29 0 0 1 32,6"
                                      Stroke="#5538BDF8" StrokeThickness="4.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <!-- 拖尾主体：由透明渐变到亮青 -->
                                <Path Data="M 13.36,9.78 A 29,29 0 0 1 32,6"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0038BDF8" Offset="0" />
                                            <GradientStop Color="#8838BDF8" Offset="0.55" />
                                            <GradientStop Color="#EE7DEBFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                </Path>

                                <!-- 拖尾粒子 -->
                                <Canvas Width="64" Height="64">
                                    <Ellipse Width="3" Height="3" Canvas.Left="19.5" Canvas.Top="7.9"
                                             Fill="#887DEBFF" />
                                    <Ellipse Width="2" Height="2" Canvas.Left="16.8" Canvas.Top="9.3"
                                             Fill="#557DEBFF" />
                                </Canvas>

                                <!-- 卫星：发光核心 -->
                                <Grid Width="12" Height="12" HorizontalAlignment="Center"
                                      VerticalAlignment="Top">
                                    <Ellipse Width="12" Height="12">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#007DEBFF" Offset="0.2" />
                                                <GradientStop Color="#AA7DEBFF" Offset="0.55" />
                                                <GradientStop Color="#007DEBFF" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="4.8" Height="4.8" Fill="#F5FFFF"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="7" ShadowDepth="0"
                                                              Color="#FF7DEBFF" Opacity="0.95" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Grid>

                            <!-- 远侧遮罩：与徽章同色，盖住飞到背面的卫星/拖尾 -->
                            <Border x:Name="BackCover" Width="46" Height="46"
                                    Canvas.Left="9" Canvas.Top="9"
                                    CornerRadius="14"
                                    Background="{DynamicResource BrandGradient}"
                                    Opacity="1" IsHitTestVisible="False" />

                            <!-- 越出徽章的透视轨道（在遮罩之上，避免闪烁） -->
                            <Ellipse Width="58" Height="28" Canvas.Left="3" Canvas.Top="18"
                                     Stroke="#5538BDF8" StrokeThickness="1" StrokeDashArray="1.5 2.5" />

                            <!-- 全息行星本体 -->
                            <Ellipse Width="22" Height="22" Canvas.Left="21" Canvas.Top="21"
                                     Opacity="0.96">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.3,0.24" Center="0.4,0.34"
                                                         RadiusX="0.78" RadiusY="0.78">
                                        <GradientStop Color="#E6F8FFFF" Offset="0" />
                                        <GradientStop Color="#CC59D8FF" Offset="0.3" />
                                        <GradientStop Color="#B32D8FD6" Offset="0.7" />
                                        <GradientStop Color="#99204A8F" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="11" ShadowDepth="0"
                                                      Color="#FF38BDF8" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- 全息扫描线（裁剪在球体内部） -->
                            <Grid Width="22" Height="22" Canvas.Left="21" Canvas.Top="21"
                                  IsHitTestVisible="False">
                                <Grid.Clip>
                                    <EllipseGeometry Center="11,11" RadiusX="11" RadiusY="11" />
                                </Grid.Clip>
                                <Rectangle Height="0.8" Width="22" Fill="#99D9FFFF"
                                           VerticalAlignment="Top" Margin="0,4,0,0" />
                                <Rectangle Height="0.8" Width="22" Fill="#77D9FFFF"
                                           VerticalAlignment="Top" Margin="0,8,0,0" />
                                <Rectangle Height="0.8" Width="22" Fill="#88D9FFFF"
                                           VerticalAlignment="Top" Margin="0,12,0,0" />
                                <Rectangle Height="0.8" Width="22" Fill="#55D9FFFF"
                                           VerticalAlignment="Top" Margin="0,16,0,0" />
                            </Grid>

                            <!-- 全息行星环，虚线缓慢流动 -->
                            <Ellipse x:Name="HoloRing" Width="37" Height="11"
                                     Canvas.Left="13.5" Canvas.Top="26.5"
                                     Stroke="#BB7DEBFF" StrokeThickness="1.2"
                                     StrokeDashArray="2 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-18" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- 球体经线，增强全息立体感 -->
                            <Ellipse Width="10" Height="22" Canvas.Left="27" Canvas.Top="21"
                                     Stroke="#5548D7FF" StrokeThickness="0.8" />
                        </Canvas>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="All Mod's Sky" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="A NMS MOD MANAGER" FontSize="9.5" Foreground="{DynamicResource TextFaint}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Library"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Library, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="模组库" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Discover"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Discover, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="发现模组" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Tools"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Tools, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="工具" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 启动游戏 + 游戏状态卡 -->
                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding LaunchGameCommand}"
                            HorizontalAlignment="Stretch" Padding="12,9" Margin="0,0,0,10"
                            ToolTip="通过 Steam 启动无人深空；未检测到 Steam 时直接运行 NMS.exe">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="启动游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ButtonBase}"
                            Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            ToolTip="打开设置">
                        <Border Style="{StaticResource CardSoft}" Padding="12,10" Background="{DynamicResource Surface2}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="游戏" FontSize="10.5" Foreground="{DynamicResource TextFaint}" />
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Ok}" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Danger}" HorizontalAlignment="Right"
                                             VerticalAlignment="Center" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </Grid>
                                <TextBlock Text="{Binding GamePath}" FontSize="11.5" Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding GamePath}" />
                                <TextBlock Text="{Binding GameVersionLine}" FontSize="10.5"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- 主题 -->
                <Grid Grid.Row="4" Margin="2,12,2,0">
                    <TextBlock Text="深色模式" FontSize="12" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" IsChecked="{Binding IsDark, Mode=TwoWay}" />
                </Grid>

                <!-- 页脚 -->
                <StackPanel Grid.Row="5" Margin="2,16,2,0">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                    <Grid>
                        <TextBlock Text="v2.0.0" FontSize="10.5" Foreground="{DynamicResource TextFaint}"
                                   VerticalAlignment="Center" />
                        <Button Content="数据目录" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" FontSize="10.5"
                                Command="{Binding OpenDataFolderCommand}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 内容 ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0" Content="{Binding CurrentPageViewModel}" Margin="28,22,28,10"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <Border Grid.Row="1" Background="{DynamicResource BgElev}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding StatusLeft}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="640" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusRight}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" />
                        <Border Width="1" Height="12" Background="{DynamicResource Border}" Margin="14,0" />
                        <TextBlock Text="v2.0.0" FontSize="11" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== 轻提示 ===================== -->
        <Grid x:Name="ToastHost"
              Grid.Column="1"
              Panel.ZIndex="90"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,64"
              MaxWidth="600"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ToastScale" ScaleX="0.9" ScaleY="0.9" />
                    <TranslateTransform x:Name="ToastTranslate" Y="18" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 外层：柔和阴影（不写进气泡内部） -->
            <Border Background="{DynamicResource Surface3}" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="42" ShadowDepth="9" Opacity="0.55" Color="#000000" />
                </Border.Effect>
            </Border>

            <!-- 外层：品牌色柔光 -->
            <Border Background="{DynamicResource Accent}" CornerRadius="14" Opacity="0.16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="46" ShadowDepth="0" Opacity="0.65" Color="{DynamicResource AccentColor}" />
                </Border.Effect>
            </Border>

            <Border Background="{DynamicResource Surface3}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18,13">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToastIcon}" FontWeight="Bold" FontSize="14"
                               Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ToastMessage}" FontSize="14" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== 忙碌遮罩 ===================== -->
        <Grid Grid.Column="1" Panel.ZIndex="120" Background="#66000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="26,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.4" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Spinner}" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding BusyText}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
