<Window x:Class="AllModsSky.App.Services.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All Mod's Sky"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border Margin="26"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行（可拖动） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="10"
                        Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" Text="?"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,4,0,0"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"
                           TextWrapping="Wrap" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,14,0,0"
                       FontSize="13" LineHeight="22"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                        Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="DangerButton" Content="永久删除" Style="{StaticResource DangerButton}"
                        Padding="16,8" Margin="0,0,8,0" Click="Danger_Click" Visibility="Collapsed" />
                <Button x:Name="PrimaryButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Padding="18,8" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
