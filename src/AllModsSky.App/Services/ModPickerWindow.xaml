<Window x:Class="AllModsSky.App.Services.ModPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AllModsSky.App.Localization"
        Title="All Mod's Sky"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border Margin="26"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行（可拖动） -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="10"
                        Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                    <TextBlock Text="＋" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,4,0,0"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,0"
                       FontSize="12.5" LineHeight="21"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" />

            <TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,14,0,0"
                     Style="{StaticResource InputBox}"
                     Tag="{loc:T 搜索…}"
                     TextChanged="SearchBox_TextChanged" />

            <Border x:Name="ListHost" Grid.Row="3" Margin="0,10,0,0"
                    Background="{DynamicResource BgElev}"
                    BorderBrush="{DynamicResource BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="ModList" Style="{StaticResource PlainListBox}" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent" Padding="6,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource Surface2}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 不设勾选框，点整行切换选中，靠底色高亮表示 -->
                                <Border x:Name="Row" CornerRadius="10" Padding="10,0"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <StackPanel VerticalAlignment="Center" Margin="0,7">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background"
                                                Value="{DynamicResource Selection}" />
                                        <Setter TargetName="Row" Property="BorderBrush"
                                                Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="EmptyText" Grid.Row="3" Margin="0,16,0,0"
                       Text="{loc:T 模组库里的模组都已经在这套配置里了。}"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AllButton" Style="{StaticResource LinkButton}" Content="{loc:T 全选}"
                            Click="SelectAll_Click" />
                    <Button Style="{StaticResource LinkButton}" Content="{loc:T 清空}" Margin="14,0,0,0"
                            Click="Clear_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T 取消}" Style="{StaticResource SecondaryButton}"
                            Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="PrimaryButton" Content="{loc:T 添加}" Style="{StaticResource PrimaryButton}"
                            Padding="18,8" Click="Primary_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
