<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题 -->
    <Color x:Key="BgColor">#FF0A0E13</Color>
    <Color x:Key="BgElevColor">#FF0E141B</Color>
    <Color x:Key="SurfaceColor">#FF121A23</Color>
    <Color x:Key="Surface2Color">#FF172130</Color>
    <Color x:Key="Surface3Color">#FF1E2A3A</Color>
    <Color x:Key="BorderColor">#FF253242</Color>
    <Color x:Key="BorderSoftColor">#FF1B2635</Color>
    <Color x:Key="TextColor">#FFE9EFF7</Color>
    <Color x:Key="TextMutedColor">#FF9BAABC</Color>
    <Color x:Key="TextFaintColor">#FF6C7C90</Color>
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#FF6BA0FF</Color>
    <Color x:Key="AccentSoftColor">#FF16263D</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="OkColor">#FF3DDC97</Color>
    <Color x:Key="OkSoftColor">#FF14302A</Color>
    <Color x:Key="WarnColor">#FFF2B45C</Color>
    <Color x:Key="WarnSoftColor">#FF362A17</Color>
    <Color x:Key="DangerColor">#FFFF6B6B</Color>
    <Color x:Key="DangerSoftColor">#FF3A1D22</Color>
    <Color x:Key="SelectionColor">#FF1A2B42</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgElev" Color="{StaticResource BgElevColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkSoft" Color="{StaticResource OkSoftColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSoft" Color="{StaticResource WarnSoftColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="Selection" Color="{StaticResource SelectionColor}" />

    <SolidColorBrush x:Key="HoverOverlay" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="PressOverlay" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#80000000" />

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4C8DFF" Offset="0" />
        <GradientStop Color="#FF9B6BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF15243A" Offset="0" />
        <GradientStop Color="#FF121A23" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
