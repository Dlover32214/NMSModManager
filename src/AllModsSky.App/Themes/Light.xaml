<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题 -->
    <Color x:Key="BgColor">#FFF3F5F9</Color>
    <Color x:Key="BgElevColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="Surface2Color">#FFF2F5FA</Color>
    <Color x:Key="Surface3Color">#FFE8EDF5</Color>
    <Color x:Key="BorderColor">#FFDCE3ED</Color>
    <Color x:Key="BorderSoftColor">#FFE9EEF6</Color>
    <Color x:Key="TextColor">#FF111A24</Color>
    <Color x:Key="TextMutedColor">#FF5B6B7F</Color>
    <Color x:Key="TextFaintColor">#FF8B99A9</Color>
    <Color x:Key="AccentColor">#FF2F6FEB</Color>
    <Color x:Key="AccentHoverColor">#FF1F5ED6</Color>
    <Color x:Key="AccentSoftColor">#FFE7EEFD</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="OkColor">#FF14875A</Color>
    <Color x:Key="OkSoftColor">#FFE2F5EC</Color>
    <Color x:Key="WarnColor">#FFA86F12</Color>
    <Color x:Key="WarnSoftColor">#FFFBF0DC</Color>
    <Color x:Key="DangerColor">#FFD24545</Color>
    <Color x:Key="DangerSoftColor">#FFFDE8E8</Color>
    <Color x:Key="SelectionColor">#FFE7EEFD</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgElev" Color="{StaticResource BgElevColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkSoft" Color="{StaticResource OkSoftColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSoft" Color="{StaticResource WarnSoftColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="Selection" Color="{StaticResource SelectionColor}" />

    <SolidColorBrush x:Key="HoverOverlay" Color="#0F000000" />
    <SolidColorBrush x:Key="PressOverlay" Color="#1C000000" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#33000000" />

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2F6FEB" Offset="0" />
        <GradientStop Color="#FF7A5AF8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFEAF1FF" Offset="0" />
        <GradientStop Color="#FFFFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
