<UserControl x:Class="AllModsSky.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="760" d:DesignWidth="1040">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 保存 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="设置" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding SaveStateText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Style="{StaticResource PrimaryButton}" Content="保存设置"
                    HorizontalAlignment="Right" Command="{Binding SaveCommand}" MinWidth="110" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

                <!-- 游戏 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="游戏" Style="{StaticResource H2}" />
                        <TextBlock Text="无人深空的安装目录（包含 GAMEDATA 的那一层）"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="例如 E:\SteamLibrary\steamapps\common\No Man's Sky" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="浏览…"
                                    Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="自动检测"
                                    Command="{Binding DetectGameCommand}" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding GameHint}"
                                   Margin="2,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GameValid}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前游戏版本" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                     Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="例如 7.10" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="从存档推断"
                                    Command="{Binding AutoVersionCommand}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="用于判断模组是否过旧；留空则自动检测"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 模组位置 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="模组位置" Style="{StaticResource H2}" />
                        <TextBlock Text="模组直接放在游戏的 MODS 目录里：开启即时生效，关闭会把文件挪到停用区。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" IsReadOnly="True"
                                     Text="{Binding ModsPath, Mode=OneWay}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="打开文件夹"
                                    Command="{Binding OpenModsFolderCommand}" Margin="8,0,0,0" />
                        </Grid>

                        <Grid Margin="2,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ParkedInfo}" Style="{StaticResource SmallText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ModsStatusText}"
                                           VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModsWritable}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Style="{StaticResource DangerButton}" Content="以管理员身份重启"
                                        Padding="11,5" FontSize="11.5"
                                        Command="{Binding RestartAdminCommand}"
                                        Visibility="{Binding ModsWritable, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,16,0,0"
                                  IsChecked="{Binding CreateDisableModsFile}">
                            <TextBlock Text="没有启用任何模组时，自动写入 DISABLEMODS.TXT" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" />
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                  IsChecked="{Binding SyncEnabledFlags}">
                            <TextBlock Text="部署后把启停状态写回 GCMODSETTINGS 的 Enabled（游戏内开关），避免两套状态打架"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 存档 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="存档" Style="{StaticResource H2}" />
                        <TextBlock Text="读取最新 .hg 存档的版本、存档名与游玩时长（键名映射来自 NMSE 的 mapping.json）。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,10" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="读取存档"
                                    Command="{Binding ReadSavesCommand}" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding SaveInfoText}" Style="{StaticResource SmallText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="620" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nexus -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nexus Mods" Style="{StaticResource H2}" />
                        <TextBlock Text="浏览 Nexus 列表需要个人 API Key（免费）：登录 Nexus → 账号 → API → 页面底部 Generate。没有 Key 也能用「发现」里的浏览器链接手动下载，再把文件拖回本窗口导入。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="NexusKeyBox" Style="{StaticResource InputPassword}"
                                         PasswordChanged="NexusKeyBox_PasswordChanged" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="打开 API 页面 ↗"
                                    Command="{Binding OpenNexusApiCommand}" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AMUMSS -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="AMUMSS" Style="{StaticResource H2}" />
                        <TextBlock Text="5.50 之后游戏直接读取 MODS 里的 EXML / MBIN 散装目录；AMUMSS 用来生成、编辑这些文件。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding AmumssPath, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="AMUMSS 根目录（含 BUILDMOD.bat）" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="指定目录…"
                                    Command="{Binding BrowseAmumssCommand}" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="{Binding AmumssLine}"
                                   Margin="2,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AmumssOk}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 数据 / 关于 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="数据与关于" Style="{StaticResource H2}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据目录" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DataPath}" Style="{StaticResource MonoText}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource SmallText}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="打开数据目录"
                                    Command="{Binding OpenDataFolderCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="打开日志" Margin="6,0,0,0"
                                    Command="{Binding OpenLogsCommand}" />
                        </StackPanel>

                        <TextBlock Text="程序只读取游戏目录和存档；关闭的模组会被移动到 GAMEDATA\MODS_disabled，不会删除。"
                                   Style="{StaticResource CaptionText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
