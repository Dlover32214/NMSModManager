<UserControl x:Class="AllModsSky.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Unloaded="LibraryView_Unloaded"
             d:DesignHeight="760" d:DesignWidth="1040">

    <UserControl.Resources>
        <!-- 模组行容器 -->
        <Style x:Key="ModRowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ModRow_PreviewMouseLeftButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Surface2}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Selection}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 配置菜单里的一行（整块可点 = 切换） -->
        <Style x:Key="ProfileRowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="模组" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,5"
                           MaxWidth="520" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CountText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="添加文件夹"
                        Command="{Binding ImportFolderCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ImportFilesCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="导入模组" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Content="同步到游戏"
                        Command="{Binding DeployCommand}" Margin="0,0,7,0" />
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding RefreshCommand}" ToolTip="刷新 (F5)">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 游戏条 -->
        <Border Grid.Row="1" Style="{StaticResource CardSoft}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,9,0" Fill="{DynamicResource Ok}"
                             Visibility="{Binding GameValid, Converter={StaticResource BoolToVisibility}}" />
                    <Ellipse Width="7" Height="7" Margin="0,0,9,0" Fill="{DynamicResource Danger}"
                             Visibility="{Binding GameValid, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="游戏" Style="{StaticResource SmallText}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GamePathText}" FontSize="12" MaxWidth="420"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding GamePathText}" />
                    <TextBlock Text="{Binding GameVersionText}" Style="{StaticResource SmallText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource BadgeWarn}" Margin="10,0,0,0"
                            Visibility="{Binding DisableFlagText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding DisableFlagText}" FontSize="10.5"
                                   Foreground="{DynamicResource Warn}" />
                    </Border>
                </StackPanel>

                <Button Style="{StaticResource LinkButton}" Content="打开 MODS 文件夹"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding OpenModsFolderCommand}" />
            </Grid>
        </Border>

        <!-- 搜索 + 筛选 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- 搜索框随窗口伸缩（200~360），窗口压到最小宽度时先挤它，别挤按钮 -->
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Style="{StaticResource InputBox}" HorizontalAlignment="Stretch"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="搜索模组名、版本或来源…" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip}" Content="全部" GroupName="modFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource StringEquals}, ConverterParameter=All, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Chip}" Content="已启用" GroupName="modFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource StringEquals}, ConverterParameter=Enabled, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Chip}" Content="已停用" GroupName="modFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource StringEquals}, ConverterParameter=Disabled, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Chip}" Content="有问题" GroupName="modFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource StringEquals}, ConverterParameter=Issues, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Command="{Binding AddModsCommand}"
                        ToolTip="从模组库里挑模组加进当前配置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="添加模组" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ProfileButton" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Command="{Binding ToggleProfileMenuCommand}"
                        ToolTip="当前配置。点开可以切换、重命名或新建一套">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="配置" VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                        <TextBlock Text="·" Margin="5,0" VerticalAlignment="Center" Opacity="0.5" />
                        <!-- 名字区固定宽度：跟着文字长短伸缩的话，切配置时左边的「添加模组」会跟着左右晃 -->
                        <TextBlock Text="{Binding ActiveProfileName}" VerticalAlignment="Center"
                                   Width="96" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveProfileName}"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                   VerticalAlignment="Center" Margin="6,1,0,0" Opacity="0.75" />
                    </StackPanel>
                </Button>

                <!-- 配置菜单：StaysOpen=True + 视图里的一层透明遮罩负责“点外面关闭”，
                     避免 StaysOpen=False 时点击按钮先被弹层吞掉再重开的老问题 -->
                <Popup IsOpen="{Binding IsProfileMenuOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ProfileButton}"
                       Placement="Bottom" VerticalOffset="6" HorizontalOffset="-46"
                       StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="312" Margin="10"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="14" Padding="10,9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.42" Color="#000000" />
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="配置" FontSize="12" FontWeight="SemiBold" Margin="6,2,0,0" />
                            <TextBlock Text="每套配置管自己那份模组清单，切换即生效"
                                       Style="{StaticResource CaptionText}" Margin="6,2,0,0" />

                            <Border Style="{StaticResource Divider}" Margin="0,9" />

                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource ProfileRowButton}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    ToolTip="切换到这组配置">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   Foreground="{DynamicResource Text}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                        <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                                Padding="5,1"
                                                                Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="内置" FontSize="9"
                                                                       Foreground="{DynamicResource TextMuted}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               Style="{StaticResource CaptionText}" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                                                    Content="重命名" FontSize="11" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFaint}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                    Command="{Binding DataContext.RenameProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />

                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}"
                                                    Content="删除" FontSize="11" Margin="9,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFaint}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Deletable}"
                                                    ToolTip="只剩一套配置时不能删"
                                                    Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Divider}" Margin="0,9" />

                            <Button Style="{StaticResource GhostButton}" Content="＋ 新建配置…"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Command="{Binding NewProfileCommand}"
                                    ToolTip="把当前这套复制成一套新配置" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Style="{StaticResource GhostButton}" Content="{Binding BatchButtonText}"
                        Command="{Binding ToggleBatchCommand}" Margin="0,0,6,0"
                        ToolTip="批量选取：开启后单击整行即可选中/取消" />
                <Button Style="{StaticResource GhostButton}" Content="应用顺序"
                        Command="{Binding ApplyOrderCommand}" ToolTip="把当前配置的顺序写入 GCMODSETTINGS.MXML" />
            </StackPanel>
        </Grid>

        <!-- 批量条 -->
        <Border Grid.Row="3" Style="{StaticResource CardSoft}" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding ShowBatchBar, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedText}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource GhostButton}" Content="全选" Padding="11,5"
                            ToolTip="选中当前搜索/筛选结果里的全部模组"
                            Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="启用" Padding="11,5" Margin="4,0,0,0"
                            Command="{Binding BatchEnableCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="停用" Padding="11,5" Margin="4,0,0,0"
                            Command="{Binding BatchDisableCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="置顶" Padding="11,5" Margin="4,0,0,0"
                            Command="{Binding MoveTopCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="置底" Padding="11,5" Margin="4,0,0,0"
                            Command="{Binding MoveBottomCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="删除所选" Padding="11,5" Margin="4,0,0,0"
                            Foreground="{DynamicResource Danger}" Command="{Binding BatchDeleteCommand}" />
                </StackPanel>
                <Button Style="{StaticResource LinkButton}" Content="取消选择"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding ClearSelectionCommand}" />
            </Grid>
        </Border>

        <!-- 列表 -->
        <Grid Grid.Row="4">
            <ListBox x:Name="ModList"
                     Style="{StaticResource PlainListBox}"
                     ItemsSource="{Binding View}"
                     ItemContainerStyle="{StaticResource ModRowContainer}"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     PreviewMouseLeftButtonDown="ModList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ModList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="ModList_PreviewMouseLeftButtonUp"
                     GiveFeedback="ModList_GiveFeedback"
                     DragOver="ModList_DragOver"
                     DragLeave="ModList_DragLeave"
                     Drop="ModList_Drop">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                        <Grid Height="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 序号 -->
                            <TextBlock Grid.Column="0" Text="{Binding IndexText}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />

                            <!-- 启停 -->
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip="启用 / 停用（立即同步到游戏）" />

                            <!-- 名称 / 元信息 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="520"
                                               ToolTip="{Binding Tooltip}" />
                                    <Border Style="{StaticResource BadgeWarn}" Margin="8,0,0,0"
                                            Visibility="{Binding IsLegacyPak, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="旧式 pak" FontSize="9.5" Foreground="{DynamicResource Warn}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeWarn}" Margin="6,0,0,0"
                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="⚠" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Warn}"
                                                   ToolTip="{Binding WarningText}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource SmallText}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                    <TextBlock Text="  ·  " Style="{StaticResource SmallText}" />
                                    <TextBlock Text="{Binding FormatText}" Style="{StaticResource SmallText}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                               ToolTip="{Binding WarningText}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 适配状态 -->
                            <TextBlock Grid.Column="3" Text="{Binding CompatText}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- 操作 -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource LinkButton}" Content="移出配置"
                                        FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFaint}"
                                        ToolTip="只是从这套配置里拿掉，文件不动，之后在「模组库」里还能加回来"
                                        Command="{Binding DataContext.RemoveFromProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}"
                                        ToolTip="打开模组文件夹"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        ToolTip="从模组库移除 / 删除此模组"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="2,0,0,0">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 这套配置还没有模组 -->
            <Border Style="{StaticResource CardSoft}" Padding="36"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="460"
                    Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding EmptyHint}"
                               Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               MaxWidth="460" TextWrapping="Wrap" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                                Visibility="{Binding ShowEmptyActions, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource PrimaryButton}" Content="添加模组"
                                Command="{Binding AddModsCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="导入模组" Margin="8,0,0,0"
                                Command="{Binding ImportFilesCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="去模组库" Margin="8,0,0,0"
                                Command="{Binding OpenLibraryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 无匹配结果 -->
            <TextBlock Text="没有匹配的模组，换个关键词或筛选条件试试"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLibraryEmpty}" Value="False" />
                                    <Condition Binding="{Binding HasVisibleMods}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 配置菜单打开时的点击遮罩：点任意位置关闭菜单 -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="Transparent"
                Visibility="{Binding IsProfileMenuOpen, Converter={StaticResource BoolToVisibility}}"
                MouseDown="ProfileMenuScrim_MouseDown" />
    </Grid>
</UserControl>
