<UserControl x:Class="AllModsSky.App.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiscoverViewModel}"
             d:DesignHeight="760" d:DesignWidth="1040">

    <UserControl.Resources>
        <Style x:Key="CategoryChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="246" />
            <Setter Property="Height" Value="214" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="发现" Style="{StaticResource H1}" />
                <TextBlock Text="浏览社区模组，可跳转浏览器页面查看或手动下载" Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,5" />
            </StackPanel>
        </Grid>

        <!-- 筛选 -->
        <Border Grid.Row="1" Style="{StaticResource CardSoft}" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Chip}" Content="Nexus Mods" GroupName="source"
                                 IsChecked="{Binding SourceKey, Converter={StaticResource StringEquals}, ConverterParameter=nexus, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="oogc.cc 资源中心" GroupName="source"
                                 IsChecked="{Binding SourceKey, Converter={StaticResource StringEquals}, ConverterParameter=oogc, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <Border Style="{StaticResource Divider}" Margin="0,11,0,10" />

                <!-- Nexus -->
                <StackPanel Visibility="{Binding IsNexus, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="排序" Style="{StaticResource SmallText}" Width="40" VerticalAlignment="Center" />
                        <RadioButton Style="{StaticResource Chip}" Content="热门" GroupName="nxSort"
                                     IsChecked="{Binding NexusSort, Converter={StaticResource StringEquals}, ConverterParameter=trending, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="最新" GroupName="nxSort"
                                     IsChecked="{Binding NexusSort, Converter={StaticResource StringEquals}, ConverterParameter=latest, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="最近更新" GroupName="nxSort"
                                     IsChecked="{Binding NexusSort, Converter={StaticResource StringEquals}, ConverterParameter=updated, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分类" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                        <ListBox Grid.Column="1" ItemsSource="{Binding NexusCategories}"
                                 SelectedItem="{Binding SelectedNexusCategory}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 ItemContainerStyle="{StaticResource CategoryChipItem}"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="随机抽 10 个"
                                Command="{Binding RandomNexusCommand}"
                                ToolTip="从 Nexus 当前可获取的模组池中随机抽 10 个（没有官方随机接口）" />
                        <Button Style="{StaticResource LinkButton}" Content="在 Nexus 官网浏览全部模组 ↗"
                                Command="{Binding OpenNexusSiteCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- oogc -->
                <StackPanel Visibility="{Binding IsOogc, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="分类" Style="{StaticResource SmallText}" Width="40" VerticalAlignment="Center" />
                        <RadioButton Style="{StaticResource Chip}" Content="全部" GroupName="oogcCate"
                                     IsChecked="{Binding OogcCategory, Converter={StaticResource StringEquals}, ConverterParameter=0, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Mod" GroupName="oogcCate"
                                     IsChecked="{Binding OogcCategory, Converter={StaticResource StringEquals}, ConverterParameter=3, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="存档" GroupName="oogcCate"
                                     IsChecked="{Binding OogcCategory, Converter={StaticResource StringEquals}, ConverterParameter=2, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="工具" GroupName="oogcCate"
                                     IsChecked="{Binding OogcCategory, Converter={StaticResource StringEquals}, ConverterParameter=4, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="建模" GroupName="oogcCate"
                                     IsChecked="{Binding OogcCategory, Converter={StaticResource StringEquals}, ConverterParameter=5, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="其他" GroupName="oogcCate"
                                     IsChecked="{Binding OogcCategory, Converter={StaticResource StringEquals}, ConverterParameter=6, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBlock Text="排序" Style="{StaticResource SmallText}" Width="40" VerticalAlignment="Center" />
                        <RadioButton Style="{StaticResource Chip}" Content="最新" GroupName="oogcSort"
                                     IsChecked="{Binding OogcSort, Converter={StaticResource StringEquals}, ConverterParameter=latest, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="最多下载" GroupName="oogcSort"
                                     IsChecked="{Binding OogcSort, Converter={StaticResource StringEquals}, ConverterParameter=downloads, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="最多浏览" GroupName="oogcSort"
                                     IsChecked="{Binding OogcSort, Converter={StaticResource StringEquals}, ConverterParameter=views, Mode=TwoWay}" />

                        <TextBlock Text="费用" Style="{StaticResource SmallText}" Margin="20,0,10,0" VerticalAlignment="Center" />
                        <RadioButton Style="{StaticResource Chip}" Content="全部" GroupName="oogcCost"
                                     IsChecked="{Binding OogcCost, Converter={StaticResource StringEquals}, ConverterParameter=all, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="免费" GroupName="oogcCost"
                                     IsChecked="{Binding OogcCost, Converter={StaticResource StringEquals}, ConverterParameter=free, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="付费" GroupName="oogcCost"
                                     IsChecked="{Binding OogcCost, Converter={StaticResource StringEquals}, ConverterParameter=paid, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputBox}" Tag="搜索 oogc.cc 资源…"
                                 Text="{Binding OogcQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OogcSearch_KeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="搜索"
                                Command="{Binding SearchCommand}" Margin="8,0,0,0" MinWidth="76" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 列表 / 详情 -->
        <Grid Grid.Row="2">
            <!-- 卡片列表 -->
            <Grid Visibility="{Binding DetailOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}"
                                        Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource BorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            ClipToBounds="True">
                                        <StackPanel>
                                            <Border Height="136" Background="{DynamicResource Surface2}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextFaint}"
                                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Margin="14" MaxHeight="100" TextTrimming="CharacterEllipsis" />
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="12,10,12,12">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallText}"
                                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 加载骨架：与真实卡片同尺寸，数据到达后原位替换 -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding SkeletonItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="246" Height="214" Margin="0,0,14,14"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderSoft}"
                                        BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <Border Height="136" CornerRadius="12,12,0,0"
                                                Background="{DynamicResource Surface2}" />
                                        <StackPanel Margin="12,12,12,12">
                                            <Border Height="14" Width="152" HorizontalAlignment="Left"
                                                    CornerRadius="4" Background="{DynamicResource Surface3}" />
                                            <Border Height="14" Width="112" HorizontalAlignment="Left"
                                                    CornerRadius="4" Background="{DynamicResource Surface3}" Margin="0,6,0,0" />
                                            <Border Height="11" Width="88" HorizontalAlignment="Left"
                                                    CornerRadius="4" Background="{DynamicResource Surface3}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 分页 -->
                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Visibility="{Binding ShowPager, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource Surface2}" CornerRadius="12" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="‹" FontSize="16"
                                Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" />
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource SmallText}"
                                   VerticalAlignment="Center" Margin="10,0" />
                        <Button Style="{StaticResource IconButton}" Content="›" FontSize="16"
                                Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                    </StackPanel>
                </Border>

                <!-- 请求失败 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="⚠" FontSize="26" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Danger}" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="520" Margin="0,10,0,0" FontSize="12.5"
                               Foreground="{DynamicResource TextMuted}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="重试"
                            Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>

                <!-- 空结果 -->
                <TextBlock Text="这里还没有内容" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />

                <!-- 已加载内容时的翻页/刷新指示（首次加载用骨架，不显示这个） -->
                <ContentControl Style="{StaticResource Spinner}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowBusyOverlay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- 详情 -->
            <Grid Visibility="{Binding DetailOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Style="{StaticResource GhostButton}" Content="‹  返回列表"
                        HorizontalAlignment="Left" Command="{Binding BackCommand}" />

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Height="280" CornerRadius="14" ClipToBounds="True"
                                Background="{DynamicResource Surface2}">
                            <Image Source="{Binding DetailCover}" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource H1}" FontSize="22"
                                   Margin="0,18,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailMeta}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" FontSize="13" LineHeight="23"
                                   Margin="0,16,0,0" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="在浏览器中打开"
                            Command="{Binding OpenPageCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="复制链接" Margin="8,0,0,0"
                            Command="{Binding CopyLinkCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
