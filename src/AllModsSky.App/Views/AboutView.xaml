<UserControl x:Class="AllModsSky.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AllModsSky.App.Controls"
             xmlns:loc="clr-namespace:AllModsSky.App.Localization"
             xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             d:DesignHeight="760" d:DesignWidth="1040">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 页头 ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{loc:T 关于}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:T 项目信息、目录与更新}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,7" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="{loc:T 项目主页 ↗}"
                        Command="{Binding OpenProjectCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="{loc:T 发布页 ↗}" Margin="4,0,0,0"
                        Command="{Binding OpenReleasesCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ===================== 程序信息 ===================== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:HoloLogo Width="64" Height="64" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AppTitle}" FontSize="21" FontWeight="Bold"
                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeAccent}" Margin="10,0,0,0" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T 当前版本}" FontSize="11"
                                                   Foreground="{DynamicResource Accent}" Opacity="0.7"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentVersionText}" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding AppSubtitle}" Style="{StaticResource BodyText}"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="{Binding ProjectUrl}" Style="{StaticResource CaptionText}"
                                       Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ProjectUrl}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================== 更新 ===================== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{loc:T 版本更新}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{loc:T 进入本页面自动联网检查 GitHub Release 最新版本。}"
                                           Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{loc:T 最新版本}" Style="{StaticResource SmallText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LatestVersionText}" FontWeight="SemiBold"
                                           Margin="8,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T 检查更新}"
                                        Command="{Binding CheckUpdateCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}"
                                         VerticalAlignment="Top" Margin="0,8,10,0" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                            </StackPanel>
                            <TextBlock Text="{Binding PublishedText}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" />
                        </Grid>

                        <ProgressBar Height="4" Minimum="0" Maximum="1"
                                     Value="{Binding DownloadProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource Surface3}"
                                     Margin="0,0,0,12"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{loc:T 更新说明}" Style="{StaticResource SmallText}" Margin="0,2,0,8" />
                        <Border Background="{DynamicResource Surface2}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                Padding="14,12,4,12">
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                                </ScrollViewer.Resources>
                                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap"
                                           FontSize="12.5" LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,0,10,0" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{loc:T 下载更新版本}"
                                    Command="{Binding DownloadInstallCommand}"
                                    IsEnabled="{Binding CanInstall}" />
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T 打开发布页 ↗}"
                                    Command="{Binding OpenReleasesCommand}" Margin="6,0,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T 打开项目主页 ↗}"
                                    Command="{Binding OpenProjectCommand}" Margin="2,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{loc:T 下载后会校验（如果 Release 提供 SHA256），替换当前 exe 并自动重启；开始前会再次确认。}"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===================== 目录 ===================== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:T 目录}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T 程序目录}" Style="{StaticResource SmallText}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Height="34" Padding="12,0,4,0"
                                    Background="{DynamicResource Surface2}"
                                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="{Binding InstallPath}" Style="{StaticResource MonoText}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,34,0"
                                               ToolTip="{Binding InstallPath}" />
                                    <Button Style="{StaticResource IconGhostButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding OpenInstallFolderCommand}"
                                            ToolTip="{loc:T 打开}">
                                        <Path Style="{StaticResource ButtonIcon}"
                                              Data="M6 14l1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T 数据目录}" Style="{StaticResource SmallText}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Height="34" Padding="12,0,4,0"
                                    Background="{DynamicResource Surface2}"
                                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="{Binding DataPath}" Style="{StaticResource MonoText}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,34,0"
                                               ToolTip="{Binding DataPath}" />
                                    <Button Style="{StaticResource IconGhostButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding OpenDataFolderCommand}"
                                            ToolTip="{loc:T 打开}">
                                        <Path Style="{StaticResource ButtonIcon}"
                                              Data="M6 14l1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:T &quot;All Mod's Sky · 本项目为个人使用的《No Man's Sky》模组管理器。&quot;}"
                           Style="{StaticResource CaptionText}" Margin="4,0,0,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
