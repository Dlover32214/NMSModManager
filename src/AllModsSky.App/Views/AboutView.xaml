<UserControl x:Class="AllModsSky.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AllModsSky.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             d:DesignHeight="760" d:DesignWidth="1040">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="关于" Style="{StaticResource H1}" />
                <TextBlock Text="项目信息、目录与更新" Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="项目主页 ↗"
                        Command="{Binding OpenProjectCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="发布页 ↗" Margin="8,0,0,0"
                        Command="{Binding OpenReleasesCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" HorizontalAlignment="Left">

                <!-- 程序信息 -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="{DynamicResource BrandGradient}"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="A" FontSize="28" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding AppTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding AppSubtitle}" Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="当前版本" Style="{StaticResource SmallText}" />
                                <TextBlock Text="{Binding CurrentVersionText}" FontWeight="SemiBold"
                                           Margin="8,0,0,0" Foreground="{DynamicResource Accent}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProjectUrl}" Style="{StaticResource CaptionText}"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ProjectUrl}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 更新 -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="版本更新" Style="{StaticResource H2}" />
                                <TextBlock Text="进入本页面自动联网检查 GitHub Release 最新版本。"
                                           Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="最新版本" Style="{StaticResource SmallText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LatestVersionText}" FontWeight="SemiBold"
                                           Margin="8,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="检查更新"
                                        Command="{Binding CheckUpdateCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,4,0,10" />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" MaxWidth="700"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding PublishedText}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Height="5" Minimum="0" Maximum="1"
                                     Value="{Binding DownloadProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource Surface3}"
                                     Margin="0,0,0,10"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="更新说明" Style="{StaticResource SmallText}" Margin="0,2,0,5" />
                        <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12,9"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap"
                                           FontSize="12" LineHeight="20"
                                           Foreground="{DynamicResource TextMuted}" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="下载更新版本"
                                    Command="{Binding DownloadInstallCommand}"
                                    IsEnabled="{Binding CanInstall}" />
                            <Button Style="{StaticResource GhostButton}" Content="打开发布页 ↗"
                                    Command="{Binding OpenReleasesCommand}" Margin="8,0,0,0" />
                            <Button Style="{StaticResource GhostButton}" Content="打开项目主页 ↗"
                                    Command="{Binding OpenProjectCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="下载后会校验（如果 Release 提供 SHA256），替换当前 exe 并自动重启；开始前会再次确认。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 目录 -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="目录" Style="{StaticResource H2}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="程序目录" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding InstallPath}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding InstallPath}" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开"
                                    Command="{Binding OpenInstallFolderCommand}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据目录" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DataPath}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding DataPath}" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="All Mod's Sky · 本项目为个人使用的《No Man's Sky》模组管理器。"
                           Style="{StaticResource CaptionText}" Margin="4,0,0,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
