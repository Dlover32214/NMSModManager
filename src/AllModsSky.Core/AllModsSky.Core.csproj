<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AllModsSky.Core</RootNamespace>
    <AssemblyName>AllModsSky.Core</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="AllModsSky.Core.Models" />
    <Using Include="AllModsSky.Core.Infrastructure" />
    <Using Include="AllModsSky.Core.Integrations" />
    <Using Include="AllModsSky.Core.Localization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\mapping.json" />
    <EmbeddedResource Include="Localization\Translations\*.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
